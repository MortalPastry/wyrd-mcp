    readonly truncated: boolean;
    readonly size: number;
    readonly dehydrated: boolean | null;
    readonly placeholder_detection: 'available' | 'unavailable';
}
export interface FileMetadata {
    readonly ok: true;
    readonly rel: string;
    readonly size: number;
