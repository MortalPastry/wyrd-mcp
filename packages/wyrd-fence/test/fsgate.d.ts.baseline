}
export interface CreateFsGateOptions {
    readonly rawGrant: string;
    readonly primitives?: Primitives;
}
export declare function isRefusal(value: unknown): value is FenceRefusal;
export declare function createFsGate(options: CreateFsGateOptions): FsGate | FenceRefusal;
